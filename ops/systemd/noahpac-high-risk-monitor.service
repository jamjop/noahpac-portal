[Unit]
Description=Noah PA-C monthly high-risk clinical-source monitoring
After=network-online.target
Wants=network-online.target
OnFailure=noahpac-monitor-failure@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/noahpac-monitor.env
ExecStart=/usr/bin/flock -n /run/noahpac-clinical-monitor.lock /usr/bin/python3 /var/www/noahpac-portal/scripts/run-quarterly-monitoring.py --high-risk
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
