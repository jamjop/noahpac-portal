[Unit]
Description=Noah PA-C clinical review portal API
After=network.target

[Service]
Type=simple
User=noahpac-review
Group=noahpac-review
WorkingDirectory=/var/www/noahpac-portal/clinical-review
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /var/www/noahpac-portal/clinical-review/api_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=-/var/lib/noahpac-monitor
ReadWritePaths=-/var/www/noahpac-portal/abx/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/allergy/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/als/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/antibiogram/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/anticoag/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/calculators/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/empiric/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/naloxone/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/opioids/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/pals/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/peds/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/readiness/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/reportable/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/screener/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/sepsis/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/steroids/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/sti-guide/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/tccc/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/toxicology/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/triage/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/vaccines/last_checked.json
ReadWritePaths=-/var/www/noahpac-portal/wound/last_checked.json

[Install]
WantedBy=multi-user.target
