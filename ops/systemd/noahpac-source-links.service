[Unit]
Description=Check Noah PA-C authoritative clinical-source links
After=network-online.target
Wants=network-online.target
OnFailure=noahpac-monitor-failure@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/noahpac-monitor.env
ExecStart=/usr/bin/flock -n /run/noahpac-source-links.lock /usr/bin/python3 /var/www/noahpac-portal/scripts/check-clinical-sources.py
StandardOutput=journal
StandardError=journal
