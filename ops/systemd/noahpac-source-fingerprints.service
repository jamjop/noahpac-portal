[Unit]
Description=Fingerprint stable Noah PA-C clinical source documents
After=network-online.target
Wants=network-online.target
OnFailure=noahpac-monitor-failure@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/noahpac-monitor.env
ExecStart=/usr/bin/flock -n /run/noahpac-source-fingerprints.lock /usr/bin/python3 /var/www/noahpac-portal/scripts/monitor-source-fingerprints.py
StandardOutput=journal
StandardError=journal
